<Window x:Class="MyConsoleApp.WPF.AdministratorInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyConsoleApp.WPF"
        mc:Ignorable="d"
        Title="AdministratorInventoryWindow" Height="450" Width="800">
    <Grid>
        <DataGrid 
            x:Name="inventoryGrid"
            AutoGenerateColumns="False" 
            IsReadOnly="True" 
            CanUserAddRows="False" 
            Margin="121,102,121,101"
            SelectionChanged="AdminItemList_SelectionChanges">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Type" 
                                    Binding="{Binding Type}"
                                    Width="*"/>

                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity}"
                                    Width="*"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>

            </DataGrid.Columns>


        </DataGrid>
        <Button
            Content="Edit" 
            HorizontalAlignment="Left"
            Margin="619,338,0,0" 
            VerticalAlignment="Top" 
            Width="60"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="Edit_Button"/>
        <Button 
            Content="View Details" 
            HorizontalAlignment="Left" 
            Margin="527,338,0,0" 
            VerticalAlignment="Top" 
            Width="87"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"/>

    </Grid>
</Window>
