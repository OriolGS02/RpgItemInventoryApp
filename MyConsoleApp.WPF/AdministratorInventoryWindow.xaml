<Window x:Class="MyConsoleApp.WPF.AdministratorInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyConsoleApp.WPF"
        mc:Ignorable="d"
        Title="AdministratorInventoryWindow" Height="450" Width="800"
        Closing="AdminWindow_Closing">
    <Grid>
        <DataGrid 
            x:Name="inventoryGrid"
            AutoGenerateColumns="False" 
            IsReadOnly="True" 
            CanUserAddRows="False" 
            Margin="0,0,0,101"
            SelectionChanged="AdminItemList_SelectionChanges" Height="231" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="558">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Type" 
                                    Binding="{Binding Type}"
                                    Width="*"/>

                <DataGridTextColumn Header="Quantity"
                                    Binding="{Binding Quantity}"
                                    Width="*"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="*"/>

            </DataGrid.Columns>


        </DataGrid>
        <Button
            Content="Edit" 
            HorizontalAlignment="Left"
            Margin="619,338,0,0" 
            VerticalAlignment="Top" 
            Width="60"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="Edit_Button"/>
        <Button 
            Content="Add Item" 
            HorizontalAlignment="Left" 
            Margin="527,338,0,0" 
            VerticalAlignment="Top" 
            Width="87"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"/>
        <Label Content="Item Management" FontSize="30" HorizontalAlignment="Center" Margin="0,30,0,0" VerticalAlignment="Top"/>
        <GroupBox Header="Type" Margin="684,102,0,0" RenderTransformOrigin="0.5,0.5" VerticalContentAlignment="Center"
                  HorizontalAlignment="Left" Width="94" Height="85" VerticalAlignment="Top" >
            <StackPanel Margin="1,1,1,1" >
                <RadioButton x:Name="weaponCheck" Height="15" Content="Weapon" Margin="0,0,0,0" Checked="ItemType_Checked" />
                <RadioButton x:Name="consumableCheck" Height="15" Content="Consumable" FontSize="11" Checked="ItemType_Checked"/>
                <RadioButton x:Name="armorCheck" Height="15" Content="Armor" Checked="ItemType_Checked"/>
                <RadioButton x:Name="allCheck" Height="15" Content="All" Checked="ItemType_Checked"/>
            </StackPanel>



        </GroupBox>

    </Grid>
</Window>
