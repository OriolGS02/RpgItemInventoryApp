<Window x:Class="MyConsoleApp.WPF.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyConsoleApp.WPF"
        mc:Ignorable="d"
        Title="EditItemWindow" Height="450" Width="800"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <Grid>
        <Label Content="Edit" FontSize="30" HorizontalAlignment="Left"  VerticalAlignment="Top" Margin="367,26,0,0"/>
        <Label Content="Name:" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Margin="61,86,0,0" VerticalAlignment="Top" FontSize="15"/>
        <TextBox x:Name="editedName"  HorizontalAlignment="Left" Margin="61,116,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Background="White"/>
        <Label Content="Type:" HorizontalContentAlignment="Left" Margin="302,86,0,0" FontSize="15" HorizontalAlignment="Left" Width="44" Height="30" VerticalAlignment="Top"/>

        <GroupBox   Padding="10" Margin="266,116,0,0" RenderTransformOrigin="0.5,0.825" Height="54" VerticalAlignment="Top" HorizontalAlignment="Left" Width="263">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="231">
                <RadioButton x:Name="weaponType" Content="Weapon" GroupName="ItemType" Margin="5"/>
                <RadioButton x:Name="consumableType" Content="Consumable" GroupName="ItemType" Margin="5"/>
                <RadioButton x:Name="armorType" Content="Armor" GroupName="ItemType" Margin="5"/>
            </StackPanel>
        </GroupBox>
        <Label Content="Description:" HorizontalAlignment="Left" Margin="61,171,0,0" VerticalAlignment="Top" FontSize="15"/>
        <TextBox x:Name="descriptionString" HorizontalAlignment="Left" Height="78" Margin="61,206,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="583" MaxLength="200"/>
        <Label Content="Quantity:" HorizontalAlignment="Left" Margin="61,307,0,0" VerticalAlignment="Top" FontSize="15"/>
        <xctk:IntegerUpDown x:Name="quantityInt" Minimum="0" Maximum="999" Value="1" Width="100" Height="25" Margin="61,337,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="Save" Click="SaveUpdate" HorizontalAlignment="Left" Margin="589,337,0,0" FontSize="15" Width="55" Height="24" VerticalAlignment="Top"/>
        <Button Content="Return" Click="SaveUpdate" HorizontalAlignment="Left" Margin="529,337,0,0" FontSize="15" Width="55" Height="24" VerticalAlignment="Top"/>







    </Grid>
</Window>
