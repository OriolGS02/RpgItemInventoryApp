<Window x:Class="MyConsoleApp.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyConsoleApp.WPF"
        mc:Ignorable="d"
        Title="LoginWindow" Height="500" Width="800">
    <Grid>
        <Label Content="Login" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,50,0,0" VerticalAlignment="Top" Height="66" Width="222" BorderBrush="Black" BorderThickness="1,1,1,1" FontSize="40"/>

        <Label Content="Email:" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="200,130,0,0" VerticalAlignment="Top" FontSize="20"/>

        <Label Content="Password:" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="200,225,0,0" VerticalAlignment="Top" FontSize="20"/>

        <TextBox x:Name="emailText" HorizontalAlignment="Left" Margin="200,175,0,0" VerticalAlignment="Top" Width="350" Height="30" />

        <PasswordBox x:Name="passwordText" HorizontalAlignment="Left" Margin="200,270,0,0" VerticalAlignment="Top" Width="350" Height="30"/>
        <TextBox x:Name="passwordVisibleText" Visibility="Collapsed" HorizontalAlignment="Left" Margin="200,270,0,0" VerticalAlignment="Top" Width="350" Height="30"/>

        <Button Content="Login" Click="Login"  Height="25"  Margin="0,317,250,142" HorizontalAlignment="Right" Width="70" VerticalAlignment="Top"/>

        <Label Content="Don't have an account?" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="200,316,0,0" VerticalAlignment="Top" FontSize="10"/>

        <Button Content="Register here." Click="RegisterLink" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Margin="318,320,0,0" VerticalAlignment="Top" FontSize="10" Background="White" BorderThickness="0,0,0,0" RenderTransformOrigin="0.481,0.618" />
       
        <Button
            Content=" &lt;(0)&gt;"
            Click="ShowPassword" 
            HorizontalAlignment="Left"
            HorizontalContentAlignment="Left"
            Margin="555,270,0,0" 
            VerticalAlignment="Top"
            FontSize="15"
            Background="White"
            BorderThickness="0,0,0,0"
            RenderTransformOrigin="0.481,0.618" 
            Height="30" />



    </Grid>
</Window>
